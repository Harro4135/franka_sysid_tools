<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>franka_sysid_tools</name>
  <version>0.1.0</version>
  <description>MoveIt 2 tools for collecting Franka telemetry for Isaac Sim System Identification.</description>
  <maintainer email="oliver.harrison@mail.utoronto.ca">Harro4135</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>moveit_msgs</depend>

  <!-- Imported at runtime when --torque-source franka-robot-state subscribes to
       FrankaRobotState for link-side tau_J. -->
  <exec_depend>franka_msgs</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-casadi</exec_depend>
  <exec_depend>python3-pinocchio</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
